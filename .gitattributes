# Normalize text files to LF in the repository and working tree
* text=auto eol=lf

*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.vue   text eol=lf
*.css   text eol=lf
*.scss  text eol=lf
*.html  text eol=lf
*.sql   text eol=lf
*.sh    text eol=lf

# Binary assets
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.woff  binary
*.woff2 binary
*.docx  binary
